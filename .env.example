# Flask secret key (required in production for secure session cookies)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-in-production-to-a-random-32-byte-hex

# Database URL
# In local development: defaults to sqlite:///expenses.db if not provided
# In production on Render/Neon: set to your Neon Postgres connection string
# Example: postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///expenses.db

# Flask environment: set to "production" in deployed environment
FLASK_ENV=development
